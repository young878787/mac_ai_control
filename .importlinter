# import-linter 依賴契約（決策見 docs/decisions/0026-import-linter.md，現況與例外見 docs/flows/module-deps.md）。
# 在 repo 根目錄執行：uvx --from import-linter==2.16 --with grimp==3.19 lint-imports
# 新增或放寬契約（改 layers、source_modules、forbidden_modules、ignore_imports）等於改決策，先問使用者。
# 每條例外上一行寫原因；依賴消失後例外一定要刪（不然會報 No matches for ignored import），並同步 module-deps.md 的例外表。

[importlinter]
root_package = mac_ai
include_external_packages = True

[importlinter:contract:c1-layers]
name = C1 後端分層
type = layers
layers =
    mac_ai.assistant | mac_ai.services
    mac_ai.stt | mac_ai.ui_bus
    mac_ai.wake
    mac_ai.router
    mac_ai.db
    mac_ai.config
ignore_imports =
    # 重算 terms 的維護 CLI（python -m mac_ai.db.rebuild）重用 music_prefs 的計分邏輯
    mac_ai.db.rebuild -> mac_ai.router.music_prefs

[importlinter:contract:c2-router-flow]
name = C2 router 編排順序
type = layers
containers = mac_ai.router
layers =
    pipeline
    slow_path
    fast_path
    local_actions
    actions

[importlinter:contract:c3-router-leaves]
name = C3 底層不往上依賴編排層
type = forbidden
source_modules =
    mac_ai.router.catalog
    mac_ai.router.choices
    mac_ai.router.cloud_client
    mac_ai.router.context
    mac_ai.router.domain
    mac_ai.router.hant
    mac_ai.router.lexicon
    mac_ai.router.llm_client
    mac_ai.router.memory
    mac_ai.router.music_prefs
    mac_ai.router.native
    mac_ai.router.normalize
    mac_ai.router.profile_store
    mac_ai.router.query_intent
    mac_ai.router.search_client
    mac_ai.router.search_prefs
    mac_ai.router.sources
    mac_ai.router.tools
    mac_ai.router.weather_client
    mac_ai.router.weather_followup
    mac_ai.router.weather_prefs
    mac_ai.router.youtube_client
forbidden_modules =
    mac_ai.router.pipeline
    mac_ai.router.slow_path
    mac_ai.router.fast_path
    mac_ai.router.local_actions
    mac_ai.router.actions
ignore_imports =
    # _scan_installed 用 actions._run 跑 Spotlight；函式內 import 是為了避開循環（AGENTS「不要碰」）
    mac_ai.router.catalog -> mac_ai.router.actions

[importlinter:contract:c4-hot-path]
name = C4 熱路徑不碰 IO
type = forbidden
source_modules =
    mac_ai.router.fast_path
    mac_ai.router.query_intent
    mac_ai.router.domain
    mac_ai.router.normalize
    mac_ai.router.lexicon
    mac_ai.stt.completeness
    mac_ai.stt.endpoint
    mac_ai.wake
forbidden_modules =
    mac_ai.router.llm_client
    mac_ai.router.cloud_client
    mac_ai.router.search_client
    mac_ai.router.weather_client
    mac_ai.router.youtube_client
    mac_ai.router.native
    mac_ai.db
    subprocess
    sqlite3
    socket
    http
ignore_imports =
    # 結構債（棘輪）：Match.run 呼叫 run_tool，比對結果和執行寫在同一個類別
    mac_ai.router.fast_path -> mac_ai.router.actions
    # 結構債（棘輪）：比對階段呼叫 plan_actions（查 ACTION_TABLE 的純函式），但它放在執行模組裡
    mac_ai.router.fast_path -> mac_ai.router.local_actions
    # _scan_installed 用 actions._run 跑 Spotlight；函式內 import 是為了避開循環（AGENTS「不要碰」）
    mac_ai.router.catalog -> mac_ai.router.actions

[importlinter:contract:c5-clients]
name = C5 網路 client 只做網路與解析
type = forbidden
source_modules =
    mac_ai.router.llm_client
    mac_ai.router.cloud_client
    mac_ai.router.search_client
    mac_ai.router.weather_client
    mac_ai.router.youtube_client
forbidden_modules =
    mac_ai.db
    sqlite3
    subprocess
ignore_imports =
    # _scan_installed 用 actions._run 跑 Spotlight；函式內 import 是為了避開循環（AGENTS「不要碰」）
    mac_ai.router.catalog -> mac_ai.router.actions
    # 用純函式 pinyin_units；music_prefs 的 sqlite3 只用在型別標註（連線由呼叫端傳入）
    mac_ai.router.youtube_client -> mac_ai.router.music_prefs
