# 雲端模型（LiteLLM proxy，OpenAI 相容）。複製成 .env 後填入金鑰：cp .env.example .env && chmod 600 .env
# .env 不要提交；AI_API_KEY 留空＝雲端停用，只用本機
AI_API_URL=https://chatapi.ntubimdbirc.tw
AI_MODEL=BIRC-LLM
AI_API_KEY=

# 天氣（選用）。中央氣象署開放資料授權碼（免費，到 https://opendata.cwa.gov.tw 註冊會員後「取得授權碼」）
# 有填＝天氣用氣象署；留空＝改用免金鑰的 Open-Meteo
CWA_API_KEY=
